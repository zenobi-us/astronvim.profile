{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Chrome",
      "port": 9222,
      "pathMapping": {
        "/": "${workspaceFolder}/",
        "/app": "${workspaceFolder}/"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "/usr/bin/google-chrome",
      "runtimeArgs": [
        "--remote-debugging-port=9222"
      ]
    }
  ]
}
